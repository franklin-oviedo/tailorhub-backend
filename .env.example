# App
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN_SECONDS=86400

# Database (Render usually provides DATABASE_URL)
DATABASE_URL=

# Local DB fallback (used when DATABASE_URL is empty)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=tailorhub

# Disable in production; use migrations instead
DB_SYNCHRONIZE=false
