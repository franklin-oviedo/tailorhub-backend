# App
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
FRONTEND_APP_URL=http://localhost:4200

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN_SECONDS=86400
GOOGLE_CLIENT_ID=1023949249044-2o7m56um6f4upr599bf7sqp06e7edv1i.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4200/auth/google/callback
GOOGLE_CALENDAR_TIMEZONE=America/Santo_Domingo
GOOGLE_CALENDAR_APPOINTMENT_DURATION_MINUTES=60
SUPER_ADMIN_EMAIL=superadmin@tailorhub.local
SUPER_ADMIN_PASSWORD=TailorHub123!
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_PHONE=+1 000 000 0000
SUPER_ADMIN_STORE_NAME=TailorHub HQ
SUPER_ADMIN_STORE_EMAIL=hq@tailorhub.local
SUPER_ADMIN_STORE_PHONE=+1 000 000 0001
SUPER_ADMIN_STORE_ADDRESS=Main office

# Database (Render usually provides DATABASE_URL)
DATABASE_URL=

# Supabase Storage (for store logos)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=

# Local DB fallback (used when DATABASE_URL is empty)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=tailorhub

# Keep true in local development so entity changes are reflected in DB schema.
# In production, set this explicitly to false and use migrations.
DB_SYNCHRONIZE=true
